cabal-version:      2.4
name:               victorian-map
version:            1.0.0
synopsis:           Victorian level
build-type:         Simple
extra-source-files: assets/*.png

executable victorian-map
    main-is:          Main.hs
    other-modules:    Victoria
    build-depends:    base >=4 && <5, array, containers,h-raylib >=6.1.0.0 && <6.1.1
    default-language: Haskell2010
    ghc-options:      -O2 -Wall -threaded